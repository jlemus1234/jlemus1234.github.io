---
import Layout from '../layouts/Layout.astro';
import { contact, summary, skills, experience, education } from '../data/resume';
---

<Layout title="Resume" description={summary}>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-ink">Resume</h1>
      <p class="mt-2 max-w-2xl text-ink-muted">{summary}</p>
    </div>
    <a
      href="/Resume.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-semibold text-ink no-underline hover:border-accent hover:text-accent"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M12 16.5l-5-5 1.41-1.41L11 12.67V3h2v9.67l2.59-2.58L17 11.5l-5 5zM5 18h14v2H5z"/>
      </svg>
      Download PDF
    </a>
  </div>

  <div class="mt-6 flex flex-wrap gap-x-6 gap-y-1 text-sm text-ink-muted">
    <span>{contact.location}</span>
    <a href={`mailto:${contact.email}`} class="text-ink-muted hover:text-accent">{contact.email}</a>
    <a href={contact.github} class="text-ink-muted hover:text-accent">{contact.github}</a>
  </div>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-ink">Skills</h2>
    <dl class="mt-3 space-y-2">
      {Object.entries(skills).map(([label, items]) => (
        <div class="flex flex-wrap gap-x-2">
          <dt class="font-semibold text-ink">{label}:</dt>
          <dd class="text-ink-muted">{items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-ink">Experience</h2>
    <div class="mt-4 space-y-8">
      {experience.map((job) => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <p class="font-semibold text-ink">
              {job.employer} <span class="font-normal text-ink-muted">— {job.location}</span>
            </p>
            <p class="text-sm text-ink-muted">{job.startDate} – {job.endDate}</p>
          </div>
          <p class="italic text-ink-muted">{job.title}</p>
          <ul class="mt-2 list-disc space-y-1 pl-5 text-ink-muted">
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-lg font-semibold text-ink">Education</h2>
    <div class="mt-4 space-y-4">
      {education.map((entry) => (
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <p class="text-ink">
              <span class="font-semibold">{entry.school}</span>
              <span class="text-ink-muted"> — {entry.location}</span>
            </p>
            <p class="text-sm text-ink-muted">{entry.year}</p>
          </div>
          <p class="text-ink-muted">{entry.degree}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
