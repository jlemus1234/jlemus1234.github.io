---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { YouTube } from 'astro-embed';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, collaborators, videos, gallery, abstract, description, image } = project.data;
---

<Layout title={title} description={abstract} image={image}>
  <h1 class="text-center text-2xl font-bold text-ink">{title}</h1>
  {collaborators.length > 0 && (
    <p class="mt-1 text-center text-sm text-ink-muted">{collaborators.join(', ')}</p>
  )}

  <div class="mt-6 flex justify-center">
    <YouTube id={videos[0]} title={`${title} demo`} class="w-full overflow-hidden rounded-lg" />
  </div>

  <div class="mx-auto mt-8 max-w-2xl">
    <section>
      <h2 class="text-center text-lg font-semibold text-ink">Abstract</h2>
      <p class="mt-2 text-ink-muted">{abstract}</p>
    </section>

    <section class="mt-8">
      <h2 class="text-center text-lg font-semibold text-ink">Summary</h2>
      <p class="mt-2 whitespace-pre-line text-ink-muted">{description}</p>
    </section>
  </div>

  {gallery.length > 0 && (
    <section class="mt-8">
      <h2 class="text-center text-lg font-semibold text-ink">Gallery</h2>
      <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {gallery.map((img) => (
          <Image src={img} alt={`${title} screenshot`} width={400} class="w-full rounded-md" />
        ))}
      </div>
    </section>
  )}
</Layout>
