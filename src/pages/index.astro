---
import Layout from '../layouts/Layout.astro';
import ImageBanner from '../components/ImageBanner.astro';
import ImageCircle from '../components/ImageCircle.astro';
import ConnectedSites from '../components/ConnectedSites.astro';
import MenuCardPanel from '../components/MenuCardPanel.astro';
import MenuCard from '../components/MenuCard.astro';

import bannerImage from '../assets/SwimSense/SwimSense15.jpg';
import projectsCardImage from '../assets/SwimSense/SwimSense7.jpg';
import portraitImage from '../assets/misc/IMG8.jpg';
import resumeCardImage from '../assets/misc/IMG5.jpg';
import writingCardImage from '../assets/misc/IMG1.jpg';
---

<Layout title="Home">
  <ImageBanner image={bannerImage} alt="Jose Lemus Ortiz" />

  <div class="mt-10 flex flex-col items-center gap-8 sm:flex-row sm:items-start sm:justify-center">
    <ImageCircle image={portraitImage} alt="Jose Lemus Ortiz" />
    <div class="max-w-md text-center sm:text-left">
      <h1 class="text-2xl font-bold text-ink">About me</h1>
      <p class="mt-3 text-ink-muted">
        Hi, I'm Jose — a Software Engineer building full-stack platforms and AI-driven features, most
        recently at Wix. I studied Computer Science at Tufts University, and outside of work I enjoy
        cooking, writing, exercise, and tinkering with technology.
      </p>
    </div>
  </div>

  <div class="mt-8">
    <ConnectedSites />
  </div>

  <MenuCardPanel>
    <MenuCard href="/projects" title="Projects" text="Past projects I have worked on" image={projectsCardImage} />
    <MenuCard href="/resume" title="Experience" text="Work experience and education" image={resumeCardImage} />
    <MenuCard href="/blog" title="Blog" text="Stories and thoughts on my past experiences" image={writingCardImage} />
  </MenuCardPanel>
</Layout>
