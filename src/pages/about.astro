---
import Layout from '../layouts/Layout.astro';
import ImageCircle from '../components/ImageCircle.astro';

import portraitImage from '../assets/misc/IMG.jpg';
---

<Layout title="About">
  <div class="flex flex-col items-center gap-8 py-8 sm:flex-row sm:items-start">
    <ImageCircle image={portraitImage} alt="Jose Lemus Ortiz" loading="eager" fetchpriority="high" />
    <div class="max-w-md text-center sm:text-left">
      <h1 class="text-2xl font-bold text-ink">About Me</h1>
      <p class="mt-3 text-ink-muted">
        Hello, I'm Jose Lemus Ortiz. In my free time I like cooking, writing, exercising, and tinkering
        with technology.
      </p>
    </div>
  </div>
</Layout>
