---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Not Found">
  <div class="flex flex-col items-center py-16 text-center">
    <h1 class="text-2xl font-bold text-ink">Page not found</h1>
    <p class="mt-3 text-ink-muted">You just hit a route that doesn't exist... the sadness.</p>
    <a href="/" class="mt-6 text-accent no-underline hover:text-accent-hover">Back home</a>
  </div>
</Layout>
