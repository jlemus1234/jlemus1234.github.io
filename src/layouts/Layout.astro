---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio of Jose Lemus Ortiz.' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Jose Lemus Ortiz</title>
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink">
    <NavBar />
    <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
