---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  text?: string;
  href: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { image, title, text, href, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
---

<a
  href={href}
  class="block w-full max-w-sm overflow-hidden rounded-lg border border-border shadow-sm no-underline transition hover:shadow-md"
>
  <div class="h-56 w-full overflow-hidden">
    <Image
      src={image}
      alt={title}
      width={800}
      loading={loading}
      fetchpriority={fetchpriority}
      class="h-full w-full object-cover"
    />
  </div>
  <div class="p-4 text-center">
    <h2 class="text-lg font-semibold text-ink">{title}</h2>
    {text && <p class="mt-1 text-sm text-ink-muted">{text}</p>}
  </div>
</a>
