---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/resume', label: 'Resume' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-5">
    <a href="/" class="text-lg font-semibold text-ink no-underline hover:text-accent">
      Jose Lemus Ortiz
    </a>
    <nav>
      <ul class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
        {links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'no-underline hover:text-accent',
                  isActive ? 'font-semibold text-ink' : 'text-ink-muted',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
