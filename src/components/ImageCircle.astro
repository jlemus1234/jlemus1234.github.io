---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { image, alt, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
---

<div class="h-[220px] w-[220px] shrink-0 overflow-hidden rounded-full sm:h-[260px] sm:w-[260px]">
  <Image
    src={image}
    alt={alt}
    width={520}
    loading={loading}
    fetchpriority={fetchpriority}
    class="h-full w-full object-cover"
  />
</div>
