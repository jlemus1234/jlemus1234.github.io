---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<Image
  src={image}
  alt={alt}
  widths={[640, 960, 1280, 1920]}
  sizes="100vw"
  loading="eager"
  fetchpriority="high"
  class="max-h-[420px] w-full rounded-t-lg object-cover"
/>
