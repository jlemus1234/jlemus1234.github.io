---
import { Image } from 'astro:assets';
import githubLogo from '../images/Icons/github.svg';
import linkedinLogo from '../images/Icons/linkedin.svg';
import emailLogo from '../images/Icons/gmail.svg';

const links = [
  { href: 'https://github.com/jlemus1234', src: githubLogo, alt: 'GitHub' },
  { href: 'https://www.linkedin.com/in/jose-arturo-lemus-ortiz/', src: linkedinLogo, alt: 'LinkedIn' },
  { href: 'mailto:jose.a.lemusortiz@gmail.com', src: emailLogo, alt: 'Email' },
];
---

<div class="flex justify-center gap-6 rounded-lg bg-border py-3">
  {links.map((link) => (
    <a href={link.href}>
      <Image src={link.src} alt={link.alt} width={24} height={24} />
    </a>
  ))}
</div>
